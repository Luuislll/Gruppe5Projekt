@model Gruppe5Projekt.Models.Pruefung

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Pruefung</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Datum" class="control-label"></label>
                <input asp-for="Datum" class="form-control" />
                <span asp-validation-for="Datum" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LehrveranstaltungId" class="control-label"></label>
                <select asp-for="LehrveranstaltungId" class="form-control" asp-items="ViewBag.LehrveranstaltungId"></select>
                <span asp-validation-for="LehrveranstaltungId" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Speichern</button>
                <a asp-action="Index" asp-route-lehrveranstaltungId="@Model.LehrveranstaltungId" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Zurück zur Liste</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
