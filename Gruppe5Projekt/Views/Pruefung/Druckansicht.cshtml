@model Gruppe5Projekt.Models.Pruefung

@{
    Layout = null; // Entfernt Menüleiste, CSS und Footer der restlichen Webseite
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <title>Prüfung - @Model.Lehrveranstaltung?.Titel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background-color: #fff; color: #000; }
        @@media print {
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="p-5">

    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-5">
        <div>
            <h1 class="fw-bold">Multiple-Choice-Klausur</h1>
            <h3 class="text-secondary">@Model.Lehrveranstaltung?.Titel</h3>
            <p class="mb-0 text-muted">Dozent: @Model.Lehrveranstaltung?.Dozentenname | Datum: @Model.Datum.ToString("dd.MM.yyyy")</p>
        </div>
        <button onclick="window.print();" class="btn btn-dark no-print">
            <i class="bi bi-printer"></i> Drucken / PDF speichern
        </button>
    </div>

    @{ int count = 1; }
    @foreach (var pFrage in Model.PruefungMCFragen!)
    {
        var frage = pFrage.MCFrage;
        if (frage != null)
        {
            <div class="mb-5" style="page-break-inside: avoid;">
                <h5 class="fw-bold">Frage @count: @frage.Fragentext</h5>
                <div class="ms-3 mt-2">
                    @foreach (var option in frage.AntwortOptionen)
                    {
                        <div class="form-check my-2">
                            <input class="form-check-input" type="checkbox" style="border-color: #000;" disabled>
                            <label class="form-check-label ms-2 text-dark">
                                @option.Antworttext
                            </label>
                        </div>
                    }
                </div>
            </div>
            count++;
        }
    }

</body>
</html>