@model Gruppe5Projekt.Models.Pruefung

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Pruefung</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Datum)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Datum)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Lehrveranstaltung)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Lehrveranstaltung!.Dozentenname)
        </dd>
    </dl>
</div>

<div>
    <div class="d-flex justify-content-between align-items-center">
        <h4>Prüfungsfragen</h4>
        <button type="button" class="btn btn-success btn-sm"
                data-bs-toggle="modal" data-bs-target="#fragenModal">
            Fragen zusammenstellen
        </button>
    </div>
    <hr />

    @if (TempData["FragenFehler"] != null)
    {
        <div class="alert alert-danger">@TempData["FragenFehler"]</div>
    }
    @if (TempData["FragenHinweis"] != null)
    {
        <div class="alert alert-warning">@TempData["FragenHinweis"]</div>
    }

    @{
        var fragen = Model?.PruefungMCFragen
            .Where(pf => pf.MCFrage != null)
            .Select(pf => pf.MCFrage!)
            .OrderBy(f => f.Kapitel?.Kapitelnummer)
            .ThenBy(f => f.Id)
            .ToList() ?? new List<Gruppe5Projekt.Models.MCFrage>();
    }

    @if (fragen.Any())
    {
        <p class="text-muted">@fragen.Count Frage(n) zusammengestellt.</p>
        <ul class="list-group">
            @foreach (var frage in fragen)
            {
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <span>@frage.Fragentext</span>
                    @if (frage.Kapitel != null)
                    {
                        <span class="badge bg-secondary rounded-pill ms-2">
                            Kapitel @frage.Kapitel.Kapitelnummer: @frage.Kapitel.Titel
                        </span>
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">Für diese Prüfung wurden noch keine Fragen zusammengestellt.</p>
    }
</div>

<div class="d-flex gap-2 mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Bearbeiten</a>
    <a asp-action="Index" asp-route-lehrveranstaltungId="@Model?.LehrveranstaltungId" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Zurück zur Liste</a>
</div>

@* Pop-up zur Festlegung der Fragenanzahl. *@
<div class="modal fade" id="fragenModal" tabindex="-1" aria-labelledby="fragenModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="FragenZusammenstellen" asp-route-id="@Model?.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="fragenModalLabel">Fragen zusammenstellen</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">
                        Die Fragen werden zufällig und ohne Duplikate aus allen Kapiteln der
                        Lehrveranstaltung ausgewählt. Eine bestehende Zusammenstellung wird ersetzt.
                    </p>
                    <div class="mb-3">
                        <label for="anzahl" class="form-label">Anzahl der Fragen</label>
                        <input type="number" class="form-control" id="anzahl" name="anzahl"
                               min="1" value="10" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button>
                    <button type="submit" class="btn btn-success">Zusammenstellen</button>
                </div>
            </div>
        </form>
    </div>
</div>
