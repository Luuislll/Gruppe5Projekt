@model Gruppe5Projekt.Models.Kapitel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Kapitel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Titel" class="control-label"></label>
                <input asp-for="Titel" class="form-control" />
                <span asp-validation-for="Titel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Kapitelnummer" class="control-label"></label>
                <input asp-for="Kapitelnummer" class="form-control" />
                <span asp-validation-for="Kapitelnummer" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Foliensatz (PDF)</label>
                <input type="file" name="pdfDatei" accept="application/pdf" class="form-control" />
                <span class="text-danger">@Html.ValidationMessage("pdfDatei")</span>
            </div>
            <div class="form-group">
                <label asp-for="LehrveranstaltungId" class="control-label"></label>
                <select asp-for="LehrveranstaltungId" class ="form-control" asp-items="ViewBag.LehrveranstaltungId"></select>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Anlegen</button>
                <a asp-action="Index" asp-route-lehrveranstaltungId="@Model.LehrveranstaltungId" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Zurück zur Liste</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
