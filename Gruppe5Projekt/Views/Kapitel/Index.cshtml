@model IEnumerable<Gruppe5Projekt.Models.Kapitel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Titel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Kapitelnummer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Vorlesungsfolien)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lehrveranstaltung)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Titel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Kapitelnummer)
            </td>
            <td>
                @if (!string.IsNullOrEmpty(item.Vorlesungsfolien))
                {
                    <a asp-action="Download" asp-route-id="@item.Id">@System.IO.Path.GetFileName(item.Vorlesungsfolien)</a>
                }
                else
                {
                    <span class="text-muted">—</span>
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Lehrveranstaltung!.Dozentenname)
            </td>
            <td>
                <a asp-controller="Fragenkatalog" asp-action="Index" asp-route-kapitelId="@item.Id">Fragenkatalog</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
