@model Gruppe5Projekt.Models.Kapitel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Kapitel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Titel" class="control-label"></label>
                <input asp-for="Titel" class="form-control" />
                <span asp-validation-for="Titel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Kapitelnummer" class="control-label"></label>
                <input asp-for="Kapitelnummer" class="form-control" />
                <span asp-validation-for="Kapitelnummer" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Foliensatz (PDF)</label>
                @if (!string.IsNullOrEmpty(Model.Vorlesungsfolien))
                {
                    <p class="form-text">
                        Aktuelle Datei:
                        <a asp-action="Download" asp-route-id="@Model.Id">@System.IO.Path.GetFileName(Model.Vorlesungsfolien)</a>
                    </p>
                }
                <input type="file" name="pdfDatei" accept="application/pdf" class="form-control" />
                <span class="text-danger">@Html.ValidationMessage("pdfDatei")</span>
                <small class="form-text text-muted">Nur ausfüllen, um die vorhandene Datei zu ersetzen.</small>
            </div>
            <div class="form-group">
                <label asp-for="LehrveranstaltungId" class="control-label"></label>
                <select asp-for="LehrveranstaltungId" class="form-control" asp-items="ViewBag.LehrveranstaltungId"></select>
                <span asp-validation-for="LehrveranstaltungId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
