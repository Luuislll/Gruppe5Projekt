@model Gruppe5Projekt.Models.Kapitel

@{
    ViewData["Title"] = "Details";
    var darfBearbeiten = User.Identity?.IsAuthenticated == true;
}

<h1>Details</h1>

<div>
    <h4>Kapitel</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Titel)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Titel)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Kapitelnummer)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Kapitelnummer)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Vorlesungsfolien)
        </dt>
        <dd class = "col-sm-10">
            @if (!string.IsNullOrEmpty(Model?.Vorlesungsfolien))
            {
                <a asp-action="Download" asp-route-id="@Model.Id">@System.IO.Path.GetFileName(Model.Vorlesungsfolien)</a>
            }
            else
            {
                <span class="text-muted">Keine Datei</span>
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Lehrveranstaltung)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Lehrveranstaltung!.Titel)
        </dd>
    </dl>
</div>
<div class="d-flex gap-2">
    <a asp-controller="Fragenkatalog" asp-action="Index" asp-route-kapitelId="@Model?.Id" class="btn btn-primary"><i class="bi bi-question-circle"></i> Fragenkatalog</a>
    @if (darfBearbeiten)
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Bearbeiten</a>
    }
    <a asp-action="Index" asp-route-lehrveranstaltungId="@Model?.LehrveranstaltungId" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Zurück zur Liste</a>
</div>
