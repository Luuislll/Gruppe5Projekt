@model IEnumerable<Gruppe5Projekt.Models.ViewModels.BenutzerListeViewModel>

@{
    ViewData["Title"] = "Benutzerverwaltung";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-people-fill text-secondary"></i> Benutzerverwaltung</h2>
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-person-plus"></i> Neuer Benutzer</a>
    </div>

    @if (TempData["Fehler"] is string fehler)
    {
        <div class="alert alert-danger">@fehler</div>
    }

    <div class="table-responsive shadow-sm rounded border bg-white">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>E-Mail</th>
                    <th>Name</th>
                    <th>Rolle(n)</th>
                    <th class="text-end">Aktionen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-bold">@user.Email</td>
                        <td>@($"{user.FirstName} {user.LastName}".Trim())</td>
                        <td>
                            @foreach (var rolle in user.Rollen)
                            {
                                <span class="badge bg-secondary">@rolle</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger"><i class="bi bi-trash"></i> Löschen</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
