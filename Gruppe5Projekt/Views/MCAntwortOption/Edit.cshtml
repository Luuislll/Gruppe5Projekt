@model Gruppe5Projekt.Models.MCAntwortOption

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>MCAntwortOption</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Antworttext" class="control-label"></label>
                <input asp-for="Antworttext" class="form-control" />
                <span asp-validation-for="Antworttext" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IstRichtig" /> @Html.DisplayNameFor(model => model.IstRichtig)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="MCFrageId" class="control-label"></label>
                <select asp-for="MCFrageId" class="form-control" asp-items="ViewBag.MCFrageId"></select>
                <span asp-validation-for="MCFrageId" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Speichern</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Zurück zur Liste</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
