@model IEnumerable<Gruppe5Projekt.Models.MCAntwortOption>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Antworttext)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IstRichtig)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MCFrage)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Antworttext)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IstRichtig)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MCFrage!.Fragentext)
            </td>
            <td>
                <div class="btn-group">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary"><i class="bi bi-eye"></i> Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Bearbeiten</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger"><i class="bi bi-trash"></i> Löschen</a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
