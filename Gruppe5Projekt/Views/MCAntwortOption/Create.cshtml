@model Gruppe5Projekt.Models.MCAntwortOption

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>MCAntwortOption</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Antworttext" class="control-label"></label>
                <input asp-for="Antworttext" class="form-control" />
                <span asp-validation-for="Antworttext" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IstRichtig" /> @Html.DisplayNameFor(model => model.IstRichtig)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="MCFrageId" class="control-label"></label>
                <select asp-for="MCFrageId" class ="form-control" asp-items="ViewBag.MCFrageId"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
