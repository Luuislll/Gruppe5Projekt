@model IEnumerable<Gruppe5Projekt.Models.Lehrveranstaltung>

@{
    ViewData["Title"] = "Index";
}

@{
    ViewData["Title"] = "Lehrveranstaltungen";
    var darfBearbeiten = User.Identity?.IsAuthenticated == true;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-mortarboard-fill text-secondary"></i> Lehrveranstaltungen</h2>
        @if (darfBearbeiten)
        {
            <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Neue Veranstaltung</a>
        }
    </div>

    <div class="table-responsive shadow-sm rounded border bg-white">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Titel</th>
                    <th>Dozent/-in</th>
                    <th>Niveau</th>
                    <th class="text-center">Kapitel</th>
                    <th class="text-center">Prüfungen</th>
                    @if (darfBearbeiten)
                    {
                        <th class="text-end">Aktionen</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var lv in Model)
                {
                    <tr>
                        <td class="fw-bold">@lv.Titel</td>
                        <td>@lv.Dozentenname</td>
                        <td><span class="badge bg-secondary">@lv.Niveau</span></td> <td class="text-center">
                            <a asp-controller="Kapitel" asp-action="Index" asp-route-lehrveranstaltungId="@lv.Id" class="btn btn-primary position-relative">
                                <i class="bi bi-book"></i> Kapitel
                                <span class="badge bg-primary rounded-pill">@lv.Kapitel.Count</span>
                            </a>
                        </td>
                        
                        <td class="text-center">
                            <a asp-controller="Pruefung" asp-action="Index" asp-route-lehrveranstaltungId="@lv.Id" class="btn btn-purple">
                                <i class="bi bi-file-earmark-text"></i> Prüfungen
                                <span class="badge text-white rounded-pill" style="background-color: #6f42c1;">@lv.Pruefungen.Count</span>
                            </a>
                        </td>
                        
                        @if (darfBearbeiten)
                        {
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@lv.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Bearbeiten</a>
                                    <a asp-action="Delete" asp-route-id="@lv.Id" class="btn btn-danger"><i class="bi bi-trash"></i> Löschen</a>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>