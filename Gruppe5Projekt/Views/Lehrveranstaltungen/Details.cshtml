@model Gruppe5Projekt.Models.Lehrveranstaltung

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Lehrveranstaltung</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Titel)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Titel)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Dozentenname)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Dozentenname)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Niveau)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Niveau)
        </dd>
    </dl>
</div>

<div>
    <h4>Kapitel</h4>
    <hr />
    @if (Model?.Kapitel != null && Model.Kapitel.Any())
    {
        <ul class="list-group">
            @foreach (var kapitel in Model.Kapitel.OrderBy(k => k.Kapitelnummer))
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>Kapitel @kapitel.Kapitelnummer: @kapitel.Titel</span>
                    <a asp-controller="Kapitel" asp-action="Details" asp-route-id="@kapitel.Id">Details</a>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">Dieser Lehrveranstaltung sind noch keine Kapitel zugeordnet.</p>
    }
</div>

<div class="mt-4">
    <h4>Prüfungen</h4>
    <hr />
    @if (Model?.Pruefungen != null && Model.Pruefungen.Any())
    {
        <ul class="list-group">
            @foreach (var pruefung in Model.Pruefungen.OrderBy(p => p.Datum))
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>Prüfung vom @pruefung.Datum.ToString("dd.MM.yyyy")</span>
                    <span>
                        <button type="button" class="btn btn-success btn-sm"
                                data-bs-toggle="modal" data-bs-target="#fragenModal-@pruefung.Id">
                            Fragen zusammenstellen
                        </button>
                        <a asp-controller="Pruefung" asp-action="Details" asp-route-id="@pruefung.Id"
                           class="btn btn-secondary btn-sm">Details</a>
                    </span>
                </li>
            }
        </ul>

        @* Pop-up je Prüfung zur Festlegung der Fragenanzahl. *@
        @foreach (var pruefung in Model.Pruefungen)
        {
            <div class="modal fade" id="fragenModal-@pruefung.Id" tabindex="-1"
                 aria-labelledby="fragenModalLabel-@pruefung.Id" aria-hidden="true">
                <div class="modal-dialog">
                    <form asp-controller="Pruefung" asp-action="FragenZusammenstellen"
                          asp-route-id="@pruefung.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="fragenModalLabel-@pruefung.Id">
                                    Fragen zusammenstellen – Prüfung vom @pruefung.Datum.ToString("dd.MM.yyyy")
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
                            </div>
                            <div class="modal-body">
                                <p class="text-muted">
                                    Die Fragen werden zufällig und ohne Duplikate aus allen Kapiteln der
                                    Lehrveranstaltung ausgewählt. Eine bestehende Zusammenstellung wird ersetzt.
                                </p>
                                <div class="mb-3">
                                    <label for="anzahl-@pruefung.Id" class="form-label">Anzahl der Fragen</label>
                                    <input type="number" class="form-control" id="anzahl-@pruefung.Id"
                                           name="anzahl" min="1" value="10" required />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button>
                                <button type="submit" class="btn btn-success">Zusammenstellen</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted">Dieser Lehrveranstaltung sind noch keine Prüfungen zugeordnet.</p>
    }
</div>

<div class="d-flex gap-2 mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Bearbeiten</a>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Zurück zur Liste</a>
</div>
