@model Gruppe5Projekt.Models.Lehrveranstaltung

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Lehrveranstaltung</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Titel" class="control-label"></label>
                <input asp-for="Titel" class="form-control" />
                <span asp-validation-for="Titel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Dozentenname" class="control-label"></label>
                <input asp-for="Dozentenname" class="form-control" />
                <span asp-validation-for="Dozentenname" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Niveau" class="control-label"></label>
                <select asp-for="Niveau" class="form-control"></select>
                <span asp-validation-for="Niveau" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IstDemo" /> @Html.DisplayNameFor(model => model.IstDemo)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
