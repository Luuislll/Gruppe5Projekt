@model Gruppe5Projekt.Models.Kapitel

@{
    ViewData["Title"] = "Fragenkatalog";
    var hatMaterial = !string.IsNullOrEmpty(Model.Vorlesungsfolien);
}

<h1>Fragenkatalog</h1>
<h4>Kapitel @Model.Kapitelnummer: @Model.Titel</h4>
<hr />

<p>
    <a asp-action="Create" asp-route-kapitelId="@Model.Id" class="btn btn-primary">Neue Frage anlegen</a>
    <button type="button" id="ki-fragen-btn" class="btn btn-success"
            data-kapitel-id="@Model.Id"
            @(hatMaterial ? "" : "disabled")
            title="@(hatMaterial ? "Fragen aus dem hochgeladenen Material (PDF) generieren" : "Es ist kein Material (PDF) hinterlegt.")">
        Fragen Erstellen
    </button>
    <a asp-controller="Kapitel" asp-action="Details" asp-route-id="@Model.Id">Zurück zum Kapitel</a>
</p>

@* Antiforgery-Token für den AJAX-Aufruf an GenerateAIQuestion. *@
<form id="ki-fragen-form">@Html.AntiForgeryToken()</form>

@if (!Model.MCFragen.Any())
{
    <p class="text-muted">Für dieses Kapitel sind noch keine Fragen angelegt.</p>
}
else
{
    var nummer = 1;
    foreach (var frage in Model.MCFragen)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Frage @nummer: @frage.Fragentext</strong>
                <span>
                    <a asp-action="Edit" asp-route-id="@frage.Id">Bearbeiten</a> |
                    <a asp-action="Delete" asp-route-id="@frage.Id">Löschen</a>
                </span>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var option in frage.AntwortOptionen)
                {
                    <li class="list-group-item @(option.IstRichtig ? "list-group-item-success" : "")">
                        @option.Antworttext
                        @if (option.IstRichtig)
                        {
                            <span class="badge bg-success float-end">Korrekt</span>
                        }
                    </li>
                }
            </ul>
        </div>
        nummer++;
    }
}

@* Modal für die KI-gestützte Fragengenerierung. *@
<div class="modal fade" id="kiFragenModal" tabindex="-1" aria-labelledby="kiFragenModalLabel"
     aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="kiFragenModalLabel">Frage erstellen</h5>
            </div>
            <div class="modal-body">
                <div id="kiFragenLaden" class="text-center">
                    <div class="spinner-border text-success" role="status">
                        <span class="visually-hidden">Laden...</span>
                    </div>
                    <p class="mt-3 mb-0">Gemini wird kontaktiert &hellip;</p>
                </div>
                <div id="kiFragenFehler" class="alert alert-danger d-none mb-0" role="alert"></div>
            </div>
            <div id="kiFragenFooter" class="modal-footer d-none">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Schließen</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const btn = document.getElementById('ki-fragen-btn');
            if (!btn) {
                return;
            }

            const modalEl = document.getElementById('kiFragenModal');
            const modal = new bootstrap.Modal(modalEl);
            const ladenEl = document.getElementById('kiFragenLaden');
            const fehlerEl = document.getElementById('kiFragenFehler');
            const footerEl = document.getElementById('kiFragenFooter');
            const token = document.querySelector('#ki-fragen-form input[name="__RequestVerificationToken"]').value;
            const url = '@Url.Action("GenerateAIQuestion", "Fragenkatalog")';

            btn.addEventListener('click', async function () {
                // Modal in den Lade-Zustand versetzen und öffnen.
                ladenEl.classList.remove('d-none');
                fehlerEl.classList.add('d-none');
                footerEl.classList.add('d-none');
                modal.show();

                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token,
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: 'kapitelId=' + encodeURIComponent(btn.dataset.kapitelId)
                    });

                    if (!response.ok) {
                        throw new Error('Der Server antwortete mit Status ' + response.status + '.');
                    }

                    // JSON-String der generierten Frage entgegennehmen.
                    const fragenJson = await response.text();
                    console.log('Von Gemini erhaltene Frage:', fragenJson);

                    // Erfolg: Modal schließen.
                    modal.hide();
                } catch (fehler) {
                    // Fehler: Meldung samt Schließen-Button anzeigen.
                    ladenEl.classList.add('d-none');
                    fehlerEl.textContent = 'Beim Erstellen der Frage ist ein Fehler aufgetreten: ' + fehler.message;
                    fehlerEl.classList.remove('d-none');
                    footerEl.classList.remove('d-none');
                }
            });
        })();
    </script>
}
