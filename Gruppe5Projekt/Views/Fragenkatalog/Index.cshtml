@model Gruppe5Projekt.Models.Kapitel

@{
    ViewData["Title"] = "Fragenkatalog";
    var hatMaterial = !string.IsNullOrEmpty(Model.Vorlesungsfolien);
}

<h1>Fragenkatalog</h1>
<h4>Kapitel @Model.Kapitelnummer: @Model.Titel</h4>
<hr />

<div class="d-flex flex-wrap gap-2 mb-4">
    <button type="button" id="ki-fragen-btn" class="btn btn-success"
            data-kapitel-id="@Model.Id"
            @(hatMaterial ? "" : "disabled")
            title="@(hatMaterial ? "Fragen aus dem hochgeladenen Material (PDF) generieren" : "Es ist kein Material (PDF) hinterlegt.")">
        <i class="bi bi-cpu"></i> Neue Frage generieren
    </button>
    <a asp-action="Create" asp-route-kapitelId="@Model.Id" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Neue Frage anlegen</a>
    <a asp-controller="Kapitel" asp-action="Index" asp-route-lehrveranstaltungId="@Model.LehrveranstaltungId" class="btn btn-outline-secondary ms-auto"><i class="bi bi-arrow-left"></i> Zurück zu den Kapiteln</a>
</div>

@* Antiforgery-Token für den AJAX-Aufruf an GenerateAIQuestion. *@
<form id="ki-fragen-form">@Html.AntiForgeryToken()</form>

<div id="fragen-liste">
@if (!Model.MCFragen.Any())
{
    <p class="text-muted" id="keine-fragen">Für dieses Kapitel sind noch keine Fragen angelegt.</p>
}
else
{
    var nummer = 1;
    foreach (var frage in Model.MCFragen)
    {
        <div class="card mb-3 frage-card" data-frage-id="@frage.Id">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Frage @nummer: @frage.Fragentext</strong>
                <span class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-info pruefen-btn"><i class="bi bi-robot"></i> Prüfen</button>
                    <a asp-action="Edit" asp-route-id="@frage.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Bearbeiten</a>
                    <a asp-action="Delete" asp-route-id="@frage.Id" class="btn btn-danger"><i class="bi bi-trash"></i> Löschen</a>
                </span>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var option in frage.AntwortOptionen)
                {
                    <li class="list-group-item @(option.IstRichtig ? "list-group-item-success" : "")">
                        @option.Antworttext
                        @if (option.IstRichtig)
                        {
                            <span class="badge bg-success float-end">Korrekt</span>
                        }
                    </li>
                }
            </ul>
            <div class="card-footer pruef-ergebnis d-none"></div>
        </div>
        nummer++;
    }
}
</div>

@* Modal für die KI-gestützte Fragengenerierung. *@
<div class="modal fade" id="kiFragenModal" tabindex="-1" aria-labelledby="kiFragenModalLabel"
     aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="kiFragenModalLabel">Frage erstellen</h5>
            </div>
            <div class="modal-body">
                <div id="kiFragenLaden" class="text-center">
                    <div class="spinner-border text-success" role="status">
                        <span class="visually-hidden">Laden...</span>
                    </div>
                    <p class="mt-3 mb-0">Gemini wird kontaktiert &hellip;</p>
                </div>
                <div id="kiFragenFehler" class="alert alert-danger d-none mb-0" role="alert"></div>
            </div>
            <div id="kiFragenFooter" class="modal-footer d-none">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Schließen</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const btn = document.getElementById('ki-fragen-btn');
            if (!btn) {
                return;
            }

            const modalEl = document.getElementById('kiFragenModal');
            const modal = new bootstrap.Modal(modalEl);
            const ladenEl = document.getElementById('kiFragenLaden');
            const fehlerEl = document.getElementById('kiFragenFehler');
            const footerEl = document.getElementById('kiFragenFooter');
            const token = document.querySelector('#ki-fragen-form input[name="__RequestVerificationToken"]').value;
            const url = '@Url.Action("GenerateAIQuestion", "Fragenkatalog")';

            // Hängt eine neu generierte Frage als Karte in die Liste ein.
            function fuegeFrageEin(frage) {
                const liste = document.getElementById('fragen-liste');

                // Platzhalter "noch keine Fragen" entfernen, falls vorhanden.
                document.getElementById('keine-fragen')?.remove();

                const nummer = liste.querySelectorAll('.frage-card').length + 1;

                const card = document.createElement('div');
                card.className = 'card mb-3 frage-card';
                card.dataset.frageId = frage.id;

                const header = document.createElement('div');
                header.className = 'card-header d-flex justify-content-between align-items-center';

                const titel = document.createElement('strong');
                titel.textContent = `Frage ${nummer}: ${frage.fragentext}`;

                const aktionen = document.createElement('span');
                aktionen.className = 'd-flex gap-2';
                const pruefen = document.createElement('button');
                pruefen.type = 'button';
                pruefen.className = 'btn btn-outline-info pruefen-btn';
                pruefen.innerHTML = '<i class="bi bi-robot"></i> Prüfen';
                const edit = document.createElement('a');
                edit.href = '/Fragenkatalog/Edit/' + frage.id;
                edit.className = 'btn btn-warning';
                edit.innerHTML = '<i class="bi bi-pencil"></i> Bearbeiten';
                const loeschen = document.createElement('a');
                loeschen.href = '/Fragenkatalog/Delete/' + frage.id;
                loeschen.className = 'btn btn-danger';
                loeschen.innerHTML = '<i class="bi bi-trash"></i> Löschen';
                aktionen.append(pruefen, edit, loeschen);

                header.append(titel, aktionen);

                const optionen = document.createElement('ul');
                optionen.className = 'list-group list-group-flush';
                for (const option of frage.antworten) {
                    const li = document.createElement('li');
                    li.className = 'list-group-item' + (option.istRichtig ? ' list-group-item-success' : '');
                    li.textContent = option.antworttext;
                    if (option.istRichtig) {
                        const badge = document.createElement('span');
                        badge.className = 'badge bg-success float-end';
                        badge.textContent = 'Korrekt';
                        li.appendChild(badge);
                    }
                    optionen.appendChild(li);
                }

                const ergebnis = document.createElement('div');
                ergebnis.className = 'card-footer pruef-ergebnis d-none';

                card.append(header, optionen, ergebnis);
                liste.appendChild(card);
            }

            const pruefUrl = '@Url.Action("PruefeFrage", "Fragenkatalog")';

            // Stellt das Prüfergebnis einer Frage im card-footer dar.
            function zeigeErgebnis(container, ergebnis) {
                container.className = 'card-footer pruef-ergebnis '
                    + (ergebnis.istGueltig ? 'border-success' : 'border-danger');
                container.innerHTML = '';

                const kopf = document.createElement('div');
                kopf.className = 'fw-bold mb-2 ' + (ergebnis.istGueltig ? 'text-success' : 'text-danger');
                kopf.textContent = ergebnis.istGueltig
                    ? '✓ Frage ist gültig'
                    : '✗ Frage weist Mängel auf';
                container.appendChild(kopf);

                const kriterien = [
                    ['Sprachlich korrekt', ergebnis.sprachlichKorrekt],
                    ['Genau eine richtige Antwort', ergebnis.genauEineRichtigeAntwort],
                    ['Eindeutig beantwortbar', ergebnis.beantwortbar]
                ];
                const liste = document.createElement('ul');
                liste.className = 'list-unstyled mb-2';
                for (const [text, ok] of kriterien) {
                    const li = document.createElement('li');
                    li.className = ok ? 'text-success' : 'text-danger';
                    li.textContent = (ok ? '✓ ' : '✗ ') + text;
                    liste.appendChild(li);
                }
                container.appendChild(liste);

                if (ergebnis.begruendung) {
                    const p = document.createElement('p');
                    p.className = 'mb-1';
                    p.textContent = ergebnis.begruendung;
                    container.appendChild(p);
                }

                if (ergebnis.verbesserungsvorschlaege && ergebnis.verbesserungsvorschlaege.length) {
                    const titel = document.createElement('div');
                    titel.className = 'fw-bold';
                    titel.textContent = 'Verbesserungsvorschläge:';
                    const vlist = document.createElement('ul');
                    vlist.className = 'mb-0';
                    for (const v of ergebnis.verbesserungsvorschlaege) {
                        const li = document.createElement('li');
                        li.textContent = v;
                        vlist.appendChild(li);
                    }
                    container.append(titel, vlist);
                }

                container.classList.remove('d-none');
            }

            // Prüfen-Buttons über Event-Delegation behandeln (auch für neu eingefügte Karten).
            document.getElementById('fragen-liste').addEventListener('click', async function (e) {
                const pruefBtn = e.target.closest('.pruefen-btn');
                if (!pruefBtn) {
                    return;
                }

                const card = pruefBtn.closest('.frage-card');
                const frageId = card.dataset.frageId;
                const container = card.querySelector('.pruef-ergebnis');

                pruefBtn.disabled = true;
                const urspruenglich = pruefBtn.textContent;
                pruefBtn.textContent = 'Prüfen …';
                container.className = 'card-footer pruef-ergebnis text-muted';
                container.textContent = 'Gemini prüft die Frage …';
                container.classList.remove('d-none');

                try {
                    const response = await fetch(pruefUrl, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token,
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: 'id=' + encodeURIComponent(frageId)
                    });

                    if (!response.ok) {
                        throw new Error('Der Server antwortete mit Status ' + response.status + '.');
                    }

                    zeigeErgebnis(container, await response.json());
                } catch (fehler) {
                    container.className = 'card-footer pruef-ergebnis text-danger';
                    container.textContent = 'Bei der Prüfung ist ein Fehler aufgetreten: ' + fehler.message;
                } finally {
                    pruefBtn.disabled = false;
                    pruefBtn.textContent = urspruenglich;
                }
            });

            btn.addEventListener('click', async function () {
                // Modal in den Lade-Zustand versetzen und öffnen.
                ladenEl.classList.remove('d-none');
                fehlerEl.classList.add('d-none');
                footerEl.classList.add('d-none');
                modal.show();

                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token,
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: 'kapitelId=' + encodeURIComponent(btn.dataset.kapitelId)
                    });

                    if (!response.ok) {
                        throw new Error('Der Server antwortete mit Status ' + response.status + '.');
                    }

                    // Die gespeicherte Frage entgegennehmen und direkt in die Liste einfügen.
                    const frage = await response.json();
                    fuegeFrageEin(frage);

                    // Erfolg: Modal schließen.
                    modal.hide();
                } catch (fehler) {
                    // Fehler: Meldung samt Schließen-Button anzeigen.
                    ladenEl.classList.add('d-none');
                    fehlerEl.textContent = 'Beim Erstellen der Frage ist ein Fehler aufgetreten: ' + fehler.message;
                    fehlerEl.classList.remove('d-none');
                    footerEl.classList.remove('d-none');
                }
            });
        })();
    </script>
}
