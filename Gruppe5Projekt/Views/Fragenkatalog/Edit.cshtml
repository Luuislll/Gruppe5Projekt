@model FrageEingabeViewModel

@{
    ViewData["Title"] = "Frage bearbeiten";
}

<h1>Frage bearbeiten</h1>
<h4>Kapitel: @Model.KapitelTitel</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id">
            <partial name="_FrageFormular" model="Model" />
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Änderungen speichern</button>
                <a asp-action="Index" asp-route-kapitelId="@Model.KapitelId" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Zurück zum Fragenkatalog</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
